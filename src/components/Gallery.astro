---
const photos = [
  { size: "large", src:"/images/imagen1.jpg" },
  { size: "small", src:"/images/imagen2.jpg" },
  { size: "small", src:"/images/imagen3.jpg" },
  { size: "medium", src:"/images/imagen4.jpg" },
  { size: "medium", src:"/images/imagen5.jpg" },
  { size: "small", src:"/images/imagen6.jpg" },
  { size: "small", src:"/images/imagen7.jpg" },
  { size: "large", src:"/images/imagen8.jpg" },
];

const colors = [
  "rgba(232, 0, 13, 0.15)",
  "rgba(255, 209, 0, 0.1)",
  "rgba(0, 150, 255, 0.1)",
  "rgba(232, 0, 13, 0.08)",
  "rgba(255, 209, 0, 0.15)",
  "rgba(0, 200, 100, 0.08)",
  "rgba(232, 0, 13, 0.12)",
  "rgba(255, 209, 0, 0.08)",
];
---

<section id="galeria" class="gallery">
  <div class="container">
    <p class="section-overtitle">Momentos</p>
    <h2 class="section-title">
      La <span class="accent">Galería</span>
    </h2>
    <div class="photo-grid">
      {photos.map((photo, i) => (
        <div class={`photo-card photo-card--${photo.size}`} style={`--bg: ${colors[i]}`}>
            <img src={photo.src} class="photo-img" />
            <span class="photo-add">+</span>
          
        </div>
      ))}
    </div>
  </div>
</section>

<style>
/* ... (Mantén tus estilos de .gallery, .section-title, etc. igual) ... */

.photo-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(3, 200px);
  gap: 4px; /* Tu gap original */
  margin-bottom: 40px;
}

.photo-card {
  background: var(--bg, var(--mid));
  position: relative;
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.3s;
}

/* CLAVE PARA EL AJUSTE DE IMÁGENES */
.photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Ajusta la imagen sin estirarla */
  display: block;
  position: absolute;
  top: 0;
  left: 0;
}

.photo-card:hover { transform: scale(1.02); z-index: 2; }

.photo-card--large {
  grid-column: span 2;
  grid-row: span 2;
}

.photo-card--medium {
  grid-column: span 2;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px 16px 16px;
  background: linear-gradient(transparent, rgba(0,0,0,0.8));
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 1;
}

.photo-card:hover .photo-overlay {
  transform: translateY(0);
}

.photo-emoji {
  position: absolute; /* Para que quede detrás del overlay pero sobre el fondo */
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 2.5rem;
  opacity: 0.4;
}

/* ... (El resto de tus estilos de media queries e iconos de video) ... */
</style>